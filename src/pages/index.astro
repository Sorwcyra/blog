---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = getPosts();
---
<Base title="sorwcyra blog · 汪晨阳">
  <section class="intro">
    <h1>写点过程。</h1>
    <p>
      记录 RAG 与 Agent 的工程细节、踩过的坑，以及一些还在长的想法。
      不追热点，只写自己真跑过的东西。
    </p>
  </section>

  <ul class="list">
    {posts.map((p) => (
      <li>
        <a class="item" href={`${base}/posts/${p.slug}/`}>
          <time>{p.date}</time>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>
          {p.tags.length > 0 && (
            <div class="tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && <p class="empty">还没有文章。</p>}
</Base>

<style>
  .intro { padding-bottom: 40px; border-bottom: 1px solid var(--border); }
  .intro h1 { font-size: clamp(30px, 4.6vw, 42px); font-weight: 600; letter-spacing: -1px; line-height: 1.2; }
  .intro p { margin-top: 14px; color: var(--muted); font-size: 14.6px; max-width: 520px; }

  .list { list-style: none; }
  .item {
    display: block; padding: 26px 0; border-bottom: 1px solid var(--border);
    transition: opacity .2s;
  }
  .item:hover h2 { color: var(--accent); }
  .item time { font-size: 12.5px; color: var(--dim); letter-spacing: .3px; }
  .item h2 {
    font-size: 19px; font-weight: 600; margin: 6px 0 6px; line-height: 1.45;
    transition: color .2s;
  }
  .item p { color: var(--muted); font-size: 14px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tags span {
    font-size: 11.5px; color: var(--muted); background: var(--tag-bg);
    border-radius: 99px; padding: 2px 10px;
  }
  .empty { color: var(--muted); padding-top: 30px; }
</style>
