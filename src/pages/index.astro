---
import Base from '../layouts/Base.astro';
import { getPosts, getNotes } from '../lib/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = getPosts();
const notes = getNotes();
const recentNotes = notes.slice(0, 6);
---
<Base title="sorwcyra blog · 汪晨阳">
  <section class="intro">
    <h1>写点过程。</h1>
    <p>
      记录 RAG 与 Agent 的工程细节、踩过的坑，以及一些还在长的想法。
      不追热点，只写自己真跑过的东西。
    </p>
  </section>

  <ul class="list">
    {posts.map((p) => (
      <li>
        <a class="item" href={`${base}/posts/${p.slug}/`}>
          <time>{p.date}</time>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>
          {p.tags.length > 0 && (
            <div class="tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && <p class="empty">还没有文章。</p>}

  {notes.length > 0 && (
    <section class="notes-sec">
      <div class="sec-head">
        <h2>学习笔记</h2>
        <a href={`${base}/notes/`}>全部 {notes.length} 篇 →</a>
      </div>
      <ul class="nlist">
        {recentNotes.map((n) => (
          <li>
            <a href={`${base}/notes/${n.slug}/`}>
              <span class="nt">{n.title}</span>
              <span class="ntag">{n.tags[0] ?? ''}</span>
              <time>{n.date.slice(2, 7).replace('-', '/')}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .intro { padding-bottom: 40px; border-bottom: 1px solid var(--border); }
  .intro h1 { font-size: clamp(30px, 4.6vw, 42px); font-weight: 600; letter-spacing: -1px; line-height: 1.2; }
  .intro p { margin-top: 14px; color: var(--muted); font-size: 14.6px; max-width: 520px; }

  .list { list-style: none; }
  .item {
    display: block; padding: 26px 0; border-bottom: 1px solid var(--border);
    transition: opacity .2s;
  }
  .item:hover h2 { color: var(--accent); }
  .item time { font-size: 12.5px; color: var(--dim); letter-spacing: .3px; }
  .item h2 {
    font-size: 19px; font-weight: 600; margin: 6px 0 6px; line-height: 1.45;
    transition: color .2s;
  }
  .item p { color: var(--muted); font-size: 14px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tags span {
    font-size: 11.5px; color: var(--muted); background: var(--tag-bg);
    border-radius: 99px; padding: 2px 10px;
  }
  .empty { color: var(--muted); padding-top: 30px; }

  /* 学习笔记区块 */
  .notes-sec { margin-top: 54px; }
  .sec-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    padding-bottom: 14px; border-bottom: 1px solid var(--border);
  }
  .sec-head h2 { font-size: 15px; font-weight: 600; letter-spacing: .3px; }
  .sec-head a { font-size: 12.5px; color: var(--muted); }
  .sec-head a:hover { color: var(--text); }
  .nlist { list-style: none; }
  .nlist li { border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
  .nlist a {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 2px; font-size: 14px; transition: color .18s;
  }
  .nlist a:hover { color: var(--accent); }
  .nt { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ntag {
    flex: none; font-size: 11px; color: var(--dim);
    border: 1px solid var(--border); border-radius: 99px; padding: 1px 8px;
  }
  .nlist time { flex: none; font-size: 11.5px; color: var(--dim); font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) {
    .ntag { display: none; }
    .nt { font-size: 13.6px; }
  }
</style>
