---
import Base from './Base.astro';

interface Props {
  title: string;
  date: string;
  tags: string[];
  summary?: string;
  backHref: string;
  backLabel: string;
  kind?: 'post' | 'note';
  origin?: string;
}
const { title, date, tags, summary, backHref, backLabel, kind = 'post', origin } = Astro.props;
---
<Base title={`${title} · sorwcyra`} description={summary}>
  <article>
    <a class="back" href={backHref}>← {backLabel}</a>
    <h1>{title}</h1>
    <div class="meta">
      <time>{date}</time>
      {kind === 'note' && <span class="kind">学习笔记</span>}
      {tags.map((t) => <span>{t}</span>)}
    </div>
    <div class="prose">
      <slot />
    </div>
    {origin && <p class="origin">同步自 Obsidian 笔记：{origin}</p>}
  </article>
</Base>

<style>
  .back { font-size: 13px; color: var(--muted); }
  .back:hover { color: var(--text); }
  h1 {
    font-size: clamp(25px, 3.6vw, 34px); font-weight: 600; line-height: 1.35;
    letter-spacing: -.5px; margin: 18px 0 12px; text-wrap: balance;
  }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 38px; }
  .meta time { font-size: 12.5px; color: var(--dim); }
  .meta span {
    font-size: 11.5px; color: var(--muted); background: var(--tag-bg);
    border-radius: 99px; padding: 2px 10px;
  }
  .meta .kind { color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .origin {
    margin-top: 56px; padding-top: 14px; border-top: 1px solid var(--border);
    font-size: 12px; color: var(--dim);
  }
</style>
